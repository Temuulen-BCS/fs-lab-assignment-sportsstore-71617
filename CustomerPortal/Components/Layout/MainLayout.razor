@using Microsoft.AspNetCore.Components.Routing
@using CustomerPortal.Services
@implements IDisposable
@inherits LayoutComponentBase
@inject CartState CartState

<div class="page">
    <aside class="sidebar">
        <div class="sidebar-header">
            <h4 class="mb-0">CustomerPortal</h4>
        </div>

        <nav class="nav-menu">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                Home
            </NavLink>

            <NavLink href="/products" class="nav-item">
                Products
            </NavLink>

            <NavLink href="/cart" class="nav-item">
                Cart (@CartState.GetCount())
            </NavLink>

            <NavLink href="/checkout" class="nav-item">
                Checkout
            </NavLink>

            <NavLink href="/orders" class="nav-item">
                Orders
            </NavLink>
        </nav>
    </aside>

    <main class="main-content">
        <div class="topbar">
            <span>Distributed Order Processing</span>
        </div>

        <section class="content-area">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">×</a>
</div>

@code {
    protected override void OnInitialized()
    {
        CartState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        CartState.OnChange -= StateHasChanged;
    }
}