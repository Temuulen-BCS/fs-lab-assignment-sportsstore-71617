@page "/orders"
@inject HttpClient Http

<PageTitle>Orders</PageTitle>

<h2 class="mb-4">Orders</h2>

@if (isLoading)
{
    <div class="alert alert-info">Loading orders...</div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (orders == null || !orders.Any())
{
    <div class="alert alert-secondary">No orders found yet.</div>
}
else
{
    @foreach (var order in orders)
    {
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="mb-1">Order #@order.Id</h5>
                        <small class="text-muted">@order.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                    <span class="badge @GetStatusClass(order.Status) px-3 py-2">
                        @order.Status
                    </span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Customer:</strong> @order.CustomerName
                    </div>
                    <div class="col-md-6">
                        <strong>Address:</strong> @order.Address, @order.City, @order.Country
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@item.Quantity</td>
                                    <td>€@item.Price.ToString("0.00")</td>
                                    <td>€@((item.Price * item.Quantity).ToString("0.00"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light">
                                <th colspan="3" class="text-end">Total</th>
                                <th>€@order.Items.Sum(i => i.Price * i.Quantity).ToString("0.00")</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
}

@code {
    private const string ApiBaseUrl = "http://localhost:5000";
    private List<OrderViewDto>? orders;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            orders = await Http.GetFromJsonAsync<List<OrderViewDto>>($"{ApiBaseUrl}/api/orders");
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load orders from API: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "processed" => "bg-success",
            "pending" => "bg-warning text-dark",
            "submitted" => "bg-primary",
            "failed" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    public class OrderViewDto
    {
        public int Id { get; set; }
        public string CustomerName { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string Country { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime CreatedAtUtc { get; set; }
        public List<OrderItemViewDto> Items { get; set; } = new();
    }

    public class OrderItemViewDto
    {
        public long ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Price { get; set; }
        public int Quantity { get; set; }
    }
}