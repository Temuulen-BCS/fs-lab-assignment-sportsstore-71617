@page "/checkout"
@rendermode InteractiveServer
@using CustomerPortal.Services
@using System.Net.Http.Json
@inject CartState CartState
@inject IHttpClientFactory HttpClientFactory

<h3>Checkout</h3>

@if (!CartState.Items.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h4 class="mb-3">Customer Details</h4>

            <div class="mb-3">
                <label class="form-label">Customer Name</label>
                <input class="form-control" @bind="customerName" />
            </div>

            <div class="mb-3">
                <label class="form-label">Address</label>
                <input class="form-control" @bind="address" />
            </div>

            <div class="mb-3">
                <label class="form-label">City</label>
                <input class="form-control" @bind="city" />
            </div>

            <div class="mb-3">
                <label class="form-label">Country</label>
                <input class="form-control" @bind="country" />
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="mb-3">Order Summary</h4>

            @foreach (var item in CartState.Items)
            {
                <p>@item.Name x @item.Quantity (€@((item.Price * item.Quantity).ToString("0.00")))</p>
            }

            <p><b>Total: €@CartState.GetTotal().ToString("0.00")</b></p>

            <button class="btn btn-primary" @onclick="HandleCheckout">Proceed to Checkout</button>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-info mt-3">@message</div>
            }
        </div>
    </div>
}

@code {
    private string? message;

    private string customerName = "";
    private string address = "";
    private string city = "";
    private string country = "";

    private async Task HandleCheckout()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("api");

            var order = new CheckoutOrderDto
                {
                    CustomerName = customerName,
                    Address = address,
                    City = city,
                    Country = country,
                    Items = CartState.Items.Select(x => new CheckoutOrderItemDto
                    {
                        ProductId = x.ProductID,
                        ProductName = x.Name,
                        Price = x.Price,
                        Quantity = x.Quantity
                    }).ToList()
                };

            var response = await client.PostAsJsonAsync("api/orders", order);

            if (response.IsSuccessStatusCode)
            {
                message = "Order placed successfully!";
                CartState.Clear();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                message = $"Checkout failed: {error}";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }

    public class CheckoutOrderDto
    {
        public string CustomerName { get; set; } = "";
        public string Address { get; set; } = "";
        public string City { get; set; } = "";
        public string Country { get; set; } = "";
        public List<CheckoutOrderItemDto> Items { get; set; } = new();
    }

    public class CheckoutOrderItemDto
    {
        public long ProductId { get; set; }
        public string ProductName { get; set; } = "";
        public decimal Price { get; set; }
        public int Quantity { get; set; }
    }
}